{
  "version": "2.1.1",
  "language_lock": {
    "response": "ko",
    "reasoning": "ko",
    "enforced": true,
    "system_prompt_prefix": "[SYSTEM LANGUAGE LOCK] 응답은 모두 한국어로 해 주세요. 추론 내용도 모두 한국어로 출력해 주세요."
  },
  "doc_first": {
    "enabled": true,
    "required_files": [
      "docs/plans/PLAN_v{version}_{platform}.md",
      "docs/TODO.md"
    ],
    "session_auto_save_minutes": 15
  },
  "default_chain": [
    "openrouter/free",
    "gemini-1.5-flash",
    "openrouter/paid-fallback"
  ],
  "models": {
    "chat": {
      "model": "openrouter/auto",
      "temperature": 0.2,
      "max_tokens": 4096,
      "prompt_version": "chat_v0.3",
      "vision_support": false
    },
    "code": {
      "model": "gemini-1.5-pro",
      "temperature": 0.1,
      "max_tokens": 8192,
      "prompt_version": "code_v0.3",
      "vision_support": false
    },
    "vision": {
      "model": "gemini-1.5-flash",
      "temperature": 0.2,
      "prompt_version": "vision_v0.3",
      "vision_support": true
    }
  },
  "platforms": {
    "chrome": {
      "model": "code",
      "perf_budget": {
        "sw_wake_ms": 500,
        "popup_ms": 300
      }
    },
    "server": {
      "model": "code",
      "perf_budget": {
        "p95_ms": 300,
        "memory_mb": 400
      }
    }
  },
  "cache_policy": {
    "enabled": false,
    "ttl_days": 7,
    "max_entries_chrome": 500,
    "max_entries_server": 10000,
    "hit_rate_target": 0.7,
    "storage": "chrome.storage.local + server redis",
    "note": "AI 도입 보류 (2026-08-14, T-127): 관리자 기능(로컬 배치/인사이트) 우선, AI 도입은 추후 재결정. LLM 미사용 유지 — 가격 데이터 dedup 기반 비용 최적화 유지."
  },
  "cost_guard": {
    "max_cost_per_task_usd": 1.0,
    "alert_at_usd": 0.5,
    "include_saved": true
  }
}