{
  "manifest_version": 3,
  "name": "똑바 (Shop WiseBar)",
  "version": "0.7.1",
  "description": "쇼핑몰 상품 가격을 자동으로 추적하고, 내려가면 알려드려요. 똑바로 사세요.",
  "permissions": ["storage", "alarms", "notifications", "tabs", "webNavigation"],
  "host_permissions": [
    "*://smartstore.naver.com/*",
    "*://brand.naver.com/*",
    "*://search.shopping.naver.com/*",
    "*://www.coupang.com/*",
    "*://*.oliveyoung.co.kr/*",
    "http://127.0.0.1:8000/*",
    "https://shop-wisebar.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://smartstore.naver.com/*",
        "*://brand.naver.com/*",
        "*://search.shopping.naver.com/*",
        "*://www.coupang.com/*",
        "*://*.oliveyoung.co.kr/*"
      ],
      "js": ["common.js", "content.js", "swb-ui.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "똑바",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
