# 시크릿/설정 — .env에 실값 입력, 커밋 금지. 만료일은 키별 # expires 주석 필수
# PLATFORM: server
DATABASE_URL=sqlite:///./shopwisebar.db
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*
# Browserless 연동 (v0.16.13, T-124) — 크롤러 Chrome을 클라우드로 이전. 값은 .env에 실입력, 커밋 금지.
#   발급: https://app.browserless.io → API Keys. 스크립트/로그/스크린샷에 노출 금지.
#   # expires: 2026-12-31 owner: @borasarang
BROWSERLESS_TOKEN=
